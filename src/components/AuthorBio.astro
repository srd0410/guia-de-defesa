---
// Caixa de autor exibida ao final dos artigos: só nome e link para o perfil.
// As credenciais (e o selo) ficam na página /autor/, não em cada artigo.
import { AUTHOR } from '../consts';
---
<aside class="author" aria-label="Sobre o autor">
  <div class="author-mark" aria-hidden="true"></div>
  <div class="author-body">
    <p class="eyebrow">Autor</p>
    <p class="author-name">{AUTHOR.name}</p>
    <a class="author-link" href={AUTHOR.url}>Ver perfil do autor →</a>
  </div>
</aside>

<style>
  .author {
    display: flex;
    gap: 1.1rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-left: 4px solid var(--olive);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem;
    margin: 2.2rem 0 1rem;
  }
  .author-mark {
    flex: 0 0 auto;
    width: 4px;
    align-self: stretch;
    background: var(--brass);
    border-radius: 2px;
  }
  .author-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0.2rem 0 0.7rem;
  }
  .author-link {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--brass);
    text-decoration: none;
  }
</style>
