---
import '../styles/global.css';
import '@fontsource/saira-condensed/latin-600.css';
import '@fontsource/saira-condensed/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyReadingBar from '../components/StickyReadingBar.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  image?: string;
  authorPerson?: Record<string, unknown>;
  editorPerson?: Record<string, unknown>;
  breadcrumbs?: { name: string; path?: string }[];
  stickyTitle?: string;
  noindex?: boolean;
}
const props = Astro.props;
// Padrão: título da própria página. A home passa a tagline (o próprio nome do
// site já aparece na marca ao lado, seria redundante repetir).
const stickyTitle = props.stickyTitle ?? props.title;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo.jpg" type="image/jpeg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fontes: self-hosted via @fontsource (importadas no frontmatter) -->

    <SEO {...props} />

    {/* Vercel Web Analytics (pageviews privacy-friendly) + Speed Insights (Web Vitals).
        Complementam o Google Analytics — medem coisas diferentes. */}
    <Analytics />
    <SpeedInsights />

    {/* AdSense — só carrega quando o ID estiver preenchido em consts.ts */}
    {SITE.adsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}

    {/* Google Analytics — a fila (dataLayer) é montada já, mas o gtag.js só é baixado
        depois do load + ocioso (ou 4s), pra não competir com o LCP no celular. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KEC9LRFXER');
      (function () {
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KEC9LRFXER';
          document.head.appendChild(s);
        }
        function schedule() {
          if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 4000 });
          else setTimeout(load, 4000);
        }
        if (document.readyState === 'complete') schedule();
        else window.addEventListener('load', schedule);
        // visitante que sai/rola cedo ainda é contado
        ['pointerdown', 'scroll', 'keydown'].forEach(function (e) {
          window.addEventListener(e, load, { once: true, passive: true });
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <StickyReadingBar title={stickyTitle} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
