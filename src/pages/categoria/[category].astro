---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import EspacoPublicitario from '../../components/EspacoPublicitario.astro';
import BannerHead from '../../components/BannerHead.astro';
import { CATEGORIES, getCategory } from '../../consts';
import type { ImageMetadata } from 'astro';

// Banner por categoria: src/assets/banners/categoria-<slug>-banner.jpg (opcional).
const banners = import.meta.glob<{ default: ImageMetadata }>('../../assets/banners/categoria-*-banner.jpg', { eager: true });
const BANNER_ALT: Record<string, string> = {
  "defesa-pessoal": "Duas mãos abertas em postura de guarda, com rua noturna desfocada ao fundo.",
  "defesa-residencial": "Porta de madeira escura com fechadura, trava reforçada e chaves sob luz quente.",
  "equipamentos": "Mochila oliva, lanterna, canivete fechado e carteira sobre bancada escura.",
  "sobrevivencialismo": "Bússola sobre mapa topográfico, com fogareiro e garrafa diante de uma floresta.",
  "tiro": "Abafador e óculos de proteção sobre bancada de um estande vazio.",
  "ciencia-do-treinamento": "Cronômetro, bandagens, kettlebell e caderno fechado sobre piso de madeira escura.",
  "fundamentos": "Livro verde fechado, bússola e caneta sobre mesa, com vela desfocada ao fundo.",
  "legislacao": "Balança de latão, livro fechado e caneta em escritório de madeira escura.",
  "cac-tiro-desportivo": "Luneta em tripé, abafador e óculos sobre bancada de estande ao ar livre.",
  "primeiros-socorros": "Bolsa oliva aberta com ataduras, gaze, tesoura e torniquete limpos."
};

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const banner = banners[`../../assets/banners/categoria-${category.slug}-banner.jpg`]?.default;
// Só publicados: não-rascunho e com data já alcançada (ver index.astro).
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.pubDate <= new Date() && data.category === category.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Trilha (BreadcrumbList) — mesmo padrão usado em [slug].astro: Início → Categoria, passada
// como prop pro SEO.astro montar dentro do @graph único da página.
const breadcrumbs = [
  { name: 'Início', path: '/' },
  { name: category.name, path: `/categoria/${category.slug}/` },
];
---
<BaseLayout
  title={category.name}
  description={category.blurb}
  path={`/categoria/${category.slug}/`}
  type="website"
  breadcrumbs={breadcrumbs}
>
  <BannerHead image={banner} alt={BANNER_ALT[category.slug] ?? ''}>
    <p class="eyebrow">Seção</p>
    <h1>{category.name}</h1>
    <p slot="detail" class="blurb">{category.blurb}</p>
  </BannerHead>

  <div class="wrap cat-intro">
    {category.intro.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="wrap stream">
    {posts.length === 0 && <p class="empty">Ainda não há artigos nesta seção. Em breve.</p>}

    {/* Categoria — topo */}
    {posts.length > 0 && <EspacoPublicitario posicao="categoria" seed={`categoria-${category.slug}`} indice={0} />}

    {posts.map((p, i) => (
      <>
        <PostCard
          url={`/${p.slug}/`}
          title={p.data.title}
          description={p.data.description}
          category={p.data.category}
          pubDate={p.data.pubDate} cover={p.data.cover} coverAlt={p.data.coverAlt}
        />
        {/* Categoria — intercalado: depois do 3º artigo (ou do 1º, em seção curta) */}
        {i === (posts.length > 3 ? 2 : 0) && (
          <EspacoPublicitario posicao="categoria" seed={`categoria-${category.slug}`} indice={1} extra />
        )}
      </>
    ))}

    {/* Categoria — fim da lista */}
    {posts.length > 0 && <EspacoPublicitario posicao="categoria" seed={`categoria-${category.slug}`} indice={3} extra />}
  </div>
</BaseLayout>

<style>
  .blurb { color: #cfd6cf; max-width: 56ch; margin-top: 0.6rem; }
  .cat-intro { max-width: var(--measure); padding-top: 2rem; }
  .cat-intro p { color: var(--ink-soft); line-height: 1.7; margin-bottom: 1rem; }
  .cat-intro p:last-child { margin-bottom: 0; }
  .stream { max-width: var(--measure); padding-top: 1.5rem; }
  .empty { color: var(--ink-soft); padding: 1.5rem 0; }
</style>
