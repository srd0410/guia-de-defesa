---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../consts';
import { getAllFaqs } from '../../lib/faq';

export async function getStaticPaths() {
  const all = await getAllFaqs();
  return CATEGORIES.filter((c) => all.some((f) => f.category === c.slug)).map((c) => ({
    params: { category: c.slug },
    props: { category: c, entries: all.filter((f) => f.category === c.slug) },
  }));
}
const { category, entries } = Astro.props;

// Agrupa por artigo (mantém a ordem: mais recentes primeiro).
const groups: { slug: string; title: string; items: typeof entries }[] = [];
for (const e of entries) {
  let g = groups.find((x) => x.slug === e.slug);
  if (!g) { g = { slug: e.slug, title: e.title, items: [] }; groups.push(g); }
  g.items.push(e);
}
---
<BaseLayout
  title={`Perguntas frequentes: ${category.name}`}
  description={`Perguntas frequentes sobre ${category.name.toLowerCase()}, com resposta curta e link para o artigo completo.`}
  path={`/perguntas-frequentes/${category.slug}/`}
  type="website"
  noindex
  breadcrumbs={[
    { name: 'Início', path: '/' },
    { name: 'Perguntas frequentes', path: '/perguntas-frequentes/' },
    { name: category.name },
  ]}
>
  <section class="cat-head">
    <div class="wrap">
      <p class="eyebrow">Perguntas frequentes</p>
      <h1>{category.name}</h1>
      <p class="blurb">{entries.length} perguntas, agrupadas por artigo. Cada resposta leva ao texto completo.</p>
    </div>
  </section>

  <div class="wrap faq-cat">
    <p class="back"><a href="/perguntas-frequentes/">← Todos os assuntos</a> · <a href={`/categoria/${category.slug}/`}>Ver os artigos da categoria</a></p>
    {groups.map((g) => (
      <section class="group">
        <h2><a href={`/${g.slug}/`}>{g.title}</a></h2>
        <ul>
          {g.items.map((e) => (
            <li>
              <h3>{e.q}</h3>
              <p>{e.short}</p>
              <a href={`/${e.slug}/#perguntas-frequentes`}>Ver a resposta completa →</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .cat-head { background: var(--command); color: #fff; padding: 2.8rem 0; border-bottom: 3px solid var(--olive); }
  .cat-head .eyebrow { color: var(--brass); }
  .cat-head h1 { color: #fff; margin-top: 0.4rem; }
  .blurb { color: #cfd6cf; max-width: 56ch; margin-top: 0.6rem; }
  .faq-cat { max-width: var(--measure); padding-top: 1.4rem; padding-bottom: 3rem; }
  .back { font-family: var(--font-mono); font-size: 0.78rem; }
  .back a { color: var(--olive-dk); }
  .group { margin-top: 2rem; }
  .group h2 { font-size: 1.35rem; margin-bottom: 0.4rem; }
  .group h2 a { color: var(--ink); text-decoration: none; }
  .group h2 a:hover { color: var(--olive-dk); }
  .group ul { list-style: none; margin: 0; padding: 0; }
  .group li { border-bottom: 1px solid var(--line); padding: 0.9rem 0; }
  .group h3 { font-size: 1.1rem; margin: 0 0 0.25rem; }
  .group p { margin: 0 0 0.35rem; color: var(--ink-soft); }
  .group li a { font-family: var(--font-mono); font-size: 0.76rem; color: var(--olive-dk); }
</style>
